{
  "name": "react-worldwind",
  "version": "0.4.0",
  "description": "React components and hooks for NASA WorldWind: declarative globe, layers, shapes, camera control and ready-made UI widgets",
  "keywords": [
    "react",
    "worldwind",
    "nasa",
    "globe",
    "3d",
    "gis",
    "webgl",
    "map"
  ],
  "license": "MIT",
  "author": "Muzaffar Qosimov <qwertymuzaffar@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qwertymuzaffar/worldwind-ui.git",
    "directory": "packages/react"
  },
  "homepage": "https://qwertymuzaffar.github.io/worldwind-ui/react/",
  "bugs": "https://github.com/qwertymuzaffar/worldwind-ui/issues",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "styles.css",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && node -e \"require('fs').copyFileSync('../kit/styles/worldwind-ui.css','styles.css')\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@nasaworldwind/worldwind": ">=0.9.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "worldwind-kit": "^0.4.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
