{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "../packages/kit/src/index.ts",
    "../packages/react/src/index.ts",
    "../packages/angular/src/public-api.ts"
  ],
  "tsconfig": "tsconfig.typedoc.json",
  "plugin": [
    "typedoc-plugin-markdown",
    "typedoc-vitepress-theme"
  ],
  "out": "api",
  "docsRoot": ".",
  "name": "worldwind-ui API",
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeInternal": true,
  "excludeExternals": true,
  "readme": "none",
  "githubPages": false,
  "hideGenerator": true,
  "sort": [
    "kind",
    "alphabetical"
  ],
  "treatWarningsAsErrors": false,
  "validation": {
    "notExported": false,
    "invalidLink": true,
    "notDocumented": false
  },
  "gitRevision": "main",
  "sourceLinkTemplate": "https://github.com/qwertymuzaffar/worldwind-ui/blob/{gitRevision}/{path}#L{line}"
}
